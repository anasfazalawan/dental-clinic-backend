# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Allowed Origins (Comma-separated for multiple origins, or * for all in dev)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database Configuration (Supabase PostgreSQL or any PostgreSQL instance)
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct Connection: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dental_clinic_db?schema=public"

# Direct URL (Optional: Used for Prisma migrations when using connection pooler)
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
