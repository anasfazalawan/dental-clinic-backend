# ==============================================================================
# DentPulse Backend - Environment Variables Example
# Duplicate this file as .env and fill in your actual credentials.
# Never commit .env to version control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Allowed Origins (Comma-separated for multiple origins, or * in production)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://dental-clinic-frontend-nine.vercel.app

# Supabase Project Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Database Configuration (Supabase PostgreSQL or any PostgreSQL instance)
# Connection Pooler URL format (recommended for serverless & Render deployments):
# postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require"

# Direct URL (Used by Prisma for schema sync and migrations)
DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require"
